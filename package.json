{
  "name": "dsh-sfversion",
  "version": "1.2.1",
  "description": "按需视觉桥：图片描述、空间定位与 UI 还原，支持 OpenAI Chat Completions 兼容多模态接口",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "vision",
    "stepfun",
    "multimodal",
    "image"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./document": "./lib/document.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/document.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sparkmio/dsh-sfversion"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-ui-input-trigger": "*"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.6",
    "cfb": "^1.2.2",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.2.108",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "test": "node test/document.test.js"
  }
}
